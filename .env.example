# FounderLink Docker Environment Variables Template
# Copy this file to .env and replace placeholder values with your real credentials

# PostgreSQL Configuration
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_secure_rabbitmq_password

# Grafana Dashboard Admin Password
GRAFANA_PASSWORD=admin

# Gmail SMTP Email Notification Credentials
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_digit_gmail_app_password

# Razorpay Payment Gateway Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# JWT Token Secret (256-bit Base64)
JWT_SECRET=5367566B59703373367639792F423F4528482B4D6251655468576D5A71347437
